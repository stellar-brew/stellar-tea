# stellar/soroban/Rust output
target
.soroban

# project identity and alias files will be in .config/stellar
.config

# test snapshot folders from sample contracts
test_snapshots

# build output
dist
dist-ssr

# dependencies
node_modules/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# environment variables
.env
.env.*
!.env.example

# easy way to create temporary local-only files and folders
*.local.*

# macOS-specific files
.DS_Store

# generated contract clients: keep source and package.json for every
# packages/<name> client tracked (including clients generated in the future),
# and ignore only build artefacts so a client can never be built locally yet be
# missing from the repository. `dist/` is already ignored globally above.
packages/*/dist
packages/*/out
packages/*/node_modules

# generated contract client imports
src/contracts/*
!src/contracts/util.ts
!src/contracts/clients.ts
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
